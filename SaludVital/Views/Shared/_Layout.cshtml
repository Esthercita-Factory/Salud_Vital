<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SaludVital</title>
    <script>
        (function () {
            var guardado = localStorage.getItem('sv-tema');
            var tema = guardado === 'oscuro' ? 'dark'
                : guardado === 'claro' ? 'light'
                : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', tema);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dosis:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{ var action = ViewContext.RouteData.Values["action"]?.ToString(); }

    <header class="sv-header-mobile d-lg-none">
        <nav class="navbar navbar-expand-sm sv-navbar">
            <div class="container sv-contenedor">
                <a class="navbar-brand sv-marca" asp-controller="Mascotas" asp-action="Index">
                    <img class="sv-logo" src="~/favicon.png" alt="Logo de SaludVital" asp-append-version="true" />
                    SaludVital
                </a>
                <div class="d-flex align-items-center gap-2">
                    <ul class="navbar-nav flex-row align-items-center gap-1 mb-0">
                        <li class="nav-item">
                            <a class="sv-enlace-nav @(action == "Index" ? "activo" : "")"
                               asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="sv-enlace-nav @(ViewContext.RouteData.Values["controller"]?.ToString() == "Mascotas" && action == "Index" ? "activo" : "")"
                               asp-controller="Mascotas" asp-action="Index">Mascotas</a>
                        </li>
                    </ul>
                    <button type="button" id="boton-tema" class="sv-theme-toggle" aria-label="Cambiar tema" title="Cambiar tema">
                        <span class="sv-theme-track">
                            <span class="sv-theme-thumb">
                                <svg class="sv-theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="12" r="4" fill="currentColor"/>
                                    <path d="M12 2.5v2M12 19.5v2M4.58 4.58 6 6M18 18l1.42 1.42M2.5 12h2M19.5 12h2M4.58 19.42 6 18M18 6l1.42-1.42" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                                <svg class="sv-theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278z"/>
                                </svg>
                            </span>
                        </span>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <aside class="sv-sidebar d-none d-lg-flex">
        <a class="sv-sidebar-brand" asp-controller="Mascotas" asp-action="Index">
            <img class="sv-logo" src="~/favicon.png" alt="Logo" asp-append-version="true" />
            <span>SaludVital</span>
        </a>

        <nav class="sv-sidebar-nav">
            <a class="sv-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "activo" : "")"
               asp-controller="Dashboard" asp-action="Index">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.399l-.296-.004-.042.37a.5.5 0 0 1-.944 0l-.296.004-.042-.37c-.095-.003-.175.005-.296-.004zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
                </svg>
                Dashboard
            </a>
            <a class="sv-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Mascotas" && action == "Index" ? "activo" : "")"
               asp-controller="Mascotas" asp-action="Index">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664h10z"/>
                </svg>
                Mascotas
            </a>
            <a class="sv-sidebar-link @(action == "Crear" && ViewContext.RouteData.Values["controller"]?.ToString() == "Mascotas" ? "activo" : "")"
               asp-controller="Mascotas" asp-action="Crear">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                </svg>
                Registrar mascota
            </a>
        </nav>

        <div class="sv-sidebar-footer">
            <button type="button" id="boton-tema-sidebar" class="sv-sidebar-link btn w-100 text-start" aria-label="Cambiar tema">
                <svg class="sv-theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" fill="currentColor"/>
                    <path d="M12 2.5v2M12 19.5v2M4.58 4.58 6 6M18 18l1.42 1.42M2.5 12h2M19.5 12h2M4.58 19.42 6 18M18 6l1.42-1.42" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
                <svg class="sv-theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278z"/>
                </svg>
                <span class="sv-tema-label">Cambiar tema</span>
            </button>
        </div>
    </aside>

    <div class="sv-main-content">
        <div class="container sv-contenedor pb-5">
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="sv-alerta alert alert-dismissible fade show mt-3" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                    @mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer sv-footer">
            <div class="container sv-contenedor">
                &copy; @DateTime.Now.Year · SaludVital · Clínica veterinaria <a asp-controller="Mascotas" asp-action="Index">Patitas Felices</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
