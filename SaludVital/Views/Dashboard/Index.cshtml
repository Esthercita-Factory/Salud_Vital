@{
    ViewData["Title"] = "Dashboard";
    var totalMascotas = (int)ViewBag.TotalMascotas;
    var mascotasActivas = (int)ViewBag.MascotasActivas;
    var mascotasInactivas = (int)ViewBag.MascotasInactivas;
    var totalConsultas = (int)ViewBag.TotalConsultas;
    var consultasRecientes = (List<Consulta>)ViewBag.ConsultasRecientes;
    var porEspecie = (Dictionary<string, int>)ViewBag.PorEspecie;
}

<div class="sv-cabecera-ficha">
    <div>
        <h1 class="sv-titulo-pagina mb-1">Dashboard</h1>
        <p class="sv-subtitulo mb-0">Resumen general de la clínica.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="sv-stat-card">
            <span class="sv-stat-icono" style="background-color: rgba(37, 99, 235, 0.1); color: #2563eb;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664h10z"/>
                </svg>
            </span>
            <div>
                <p class="sv-stat-numero">@totalMascotas</p>
                <p class="sv-stat-label">Mascotas</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="sv-stat-card">
            <span class="sv-stat-icono" style="background-color: rgba(22, 163, 74, 0.1); color: #16a34a;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                </svg>
            </span>
            <div>
                <p class="sv-stat-numero">@mascotasActivas</p>
                <p class="sv-stat-label">Activas</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="sv-stat-card">
            <span class="sv-stat-icono" style="background-color: rgba(220, 38, 38, 0.1); color: #dc2626;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                    <path d="M4.285 9.567a.5.5 0 0 1 .683.183A3.498 3.498 0 0 0 8 11.5a3.498 3.498 0 0 0 3.032-1.75.5.5 0 1 1 .866.5A4.498 4.498 0 0 1 8 12.5a4.498 4.498 0 0 1-3.898-2.25.5.5 0 0 1 .183-.683M7 6.5C7 7.328 6.552 8 6 8s-1-.672-1-1.5S5.448 5 6 5s1 .672 1 1.5m4 0c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5S9.448 5 10 5s1 .672 1 1.5"/>
                </svg>
            </span>
            <div>
                <p class="sv-stat-numero">@mascotasInactivas</p>
                <p class="sv-stat-label">Inactivas</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="sv-stat-card">
            <span class="sv-stat-icono" style="background-color: rgba(124, 58, 237, 0.1); color: #7c3aed;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                    <path d="M3 4h10v1H3V4zm0 3h10v1H3V7zm0 3h7v1H3v-1z"/>
                </svg>
            </span>
            <div>
                <p class="sv-stat-numero">@totalConsultas</p>
                <p class="sv-stat-label">Consultas</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    @if (porEspecie.Count > 0)
    {
        <div class="col-12 col-lg-6">
            <div class="sv-ficha">
                <h2 class="sv-seccion-titulo">Mascotas por especie</h2>
                <div class="sv-species-list">
                    @foreach (var (especie, cantidad) in porEspecie.OrderByDescending(e => e.Value))
                    {
                        var porcentaje = totalMascotas > 0 ? (cantidad * 100.0 / totalMascotas) : 0;
                        <div class="sv-species-item">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="sv-species-nombre">@especie</span>
                                <span class="sv-species-cantidad">@cantidad</span>
                            </div>
                            <div class="sv-species-barra">
                                <div class="sv-species-fill" style="width: @($"{porcentaje:F0}%");"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-12 col-lg-6">
        <div class="sv-ficha">
            <h2 class="sv-seccion-titulo">Consultas recientes</h2>
            @if (consultasRecientes.Count == 0)
            {
                <p class="sv-subtitulo mb-0">No hay consultas registradas aún.</p>
            }
            else
            {
                <div class="sv-consulta-lista">
                    @foreach (var c in consultasRecientes)
                    {
                        <div class="sv-consulta-mini">
                            <span class="sv-consulta-mini-fecha">@c.Fecha.ToString("dd/MM/yyyy")</span>
                            <div class="min-w-0">
                                <p class="sv-consulta-mini-motivo mb-0 text-truncate">@c.Motivo</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
