@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="sv-page-header">
    <h1 class="sv-title text-danger">⚠️ Error</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card sv-card-eliminar">
            <div class="card-body text-center py-5">
                <i class="bi bi-exclamation-octagon" style="font-size: 4rem; color: var(--sv-danger);"></i>
                <h3 class="mt-3">¡Ups! Algo salió mal</h3>
                <p class="text-muted mt-2">Ocurrió un error inesperado. Por favor, inténtalo de nuevo más tarde.</p>
                
                @if (Model.RequestId != null)
                {
                    <div class="alert alert-light border mt-4 text-start">
                        <small class="text-muted">ID de solicitud: <code>@Model.RequestId</code></small>
                    </div>
                }

                <a asp-controller="Mascotas" asp-action="Index" class="btn btn-primary mt-3">
                    <i class="bi bi-house"></i> Volver al catálogo
                </a>
            </div>
        </div>
    </div>
</div>