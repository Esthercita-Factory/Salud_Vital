@model Consulta
@{
    var mascota = ViewBag.Mascota as Mascota;
    ViewData["Title"] = "Nueva consulta";
}

@if (mascota is null)
{
    <h1 class="text-danger">No se encontró la mascota.</h1>
}
else
{
    <div class="sv-cabecera-ficha">
        <div>
            <h1 class="sv-titulo-pagina mb-1">Nueva consulta</h1>
            <p class="sv-subtitulo mb-0">Para <strong>@mascota.Nombre</strong> (@mascota.Especie @mascota.Raza).</p>
        </div>
        <a class="btn sv-btn-secundario" asp-controller="Mascotas" asp-action="Detalles" asp-route-id="@mascota.Id">Volver a la ficha</a>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-12 col-lg-5 order-first order-lg-last">
            <div class="sv-panel-consulta">
                <div class="sv-burbuja">
                    <p class="sv-burbuja-texto">Es importante que tengas en cuenta las notas del dueño de la mascota antes de generar una consulta con un diagnóstico.</p>
                    <span class="sv-burbuja-cola"></span>
                </div>
                <div class="sv-doctor" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 210">
                        <ellipse cx="100" cy="196" rx="52" ry="8" fill="rgba(15, 23, 42, 0.12)"/>
                        <rect x="64" y="122" width="12" height="36" rx="6" fill="#2563eb"/>
                        <circle cx="70" cy="162" r="7" fill="#f2c9a0"/>
                        <rect x="72" y="122" width="56" height="64" rx="14" fill="#ffffff" stroke="#dbe3ec" stroke-width="1.5"/>
                        <path d="M84 122 L116 122 L110 134 L90 134 Z" fill="#1d4ed8"/>
                        <rect x="97" y="140" width="6" height="18" rx="1.5" fill="#2563eb"/>
                        <rect x="91" y="146" width="18" height="6" rx="1.5" fill="#2563eb"/>
                        <circle cx="100" cy="88" r="32" fill="#f2c9a0"/>
                        <circle cx="66" cy="90" r="5" fill="#f2c9a0"/>
                        <circle cx="134" cy="90" r="5" fill="#f2c9a0"/>
                        <path d="M70 84 C70 44 130 44 130 84 Z" fill="#2563eb"/>
                        <rect x="94" y="55" width="12" height="16" rx="3" fill="#ffffff"/>
                        <rect x="88" y="61" width="24" height="6" rx="3" fill="#ffffff"/>
                        <circle cx="89" cy="90" r="2.6" fill="#1e293b"/>
                        <circle cx="111" cy="90" r="2.6" fill="#1e293b"/>
                        <path d="M93 101 Q100 107 107 101" stroke="#1e293b" stroke-width="2" fill="none" stroke-linecap="round"/>
                        <circle cx="82" cy="94" r="3" fill="#f8b88b"/>
                        <circle cx="118" cy="94" r="3" fill="#f8b88b"/>
                        <g class="sv-doctor-mano">
                            <rect x="126" y="94" width="12" height="34" rx="6" fill="#2563eb"/>
                            <circle cx="132" cy="90" r="7" fill="#f2c9a0"/>
                        </g>
                    </svg>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-7">
            <div class="sv-ficha">
                <form asp-action="Crear" method="post">
                    <input type="hidden" asp-for="MascotaId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <partial name="_CamposConsulta" model="Model" />

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn sv-btn-primario">Registrar consulta</button>
                        <a class="btn sv-btn-secundario" asp-controller="Mascotas" asp-action="Detalles" asp-route-id="@mascota.Id">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
