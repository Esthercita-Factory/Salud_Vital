@model Mascota
@{
    ViewData["Title"] = $"Ficha de {Model.Nombre}";
    var especie = (Model.Especie ?? "").ToLowerInvariant();
    var claseBanner = especie switch
    {
        "perro" => "sv-cabeza-perro",
        "gato" => "sv-cabeza-gato",
        "conejo" => "sv-cabeza-conejo",
        "loro" => "sv-cabeza-loro",
        _ => ""
    };
}

<div class="row g-4 align-items-stretch">
    <div class="col-12 col-lg-7">
        @if (!string.IsNullOrEmpty(claseBanner))
        {
            <div class="sv-banner-ficha @claseBanner">
                <div class="sv-banner-overlay">
                    <div class="sv-banner-texto">
                        <h1 class="sv-banner-nombre mb-1">@Model.Nombre</h1>
                        <p class="sv-banner-sub mb-0">@Model.Especie · @Model.Raza · @(Model.Sexo == Sexo.Macho ? "Macho" : "Hembra")</p>
                    </div>
                    <div class="sv-banner-acciones d-flex gap-2 flex-wrap">
                        <a class="btn sv-btn-primario sv-btn-sm" asp-controller="Consultas" asp-action="Crear" asp-route-mascotaId="@Model.Id">Nueva consulta</a>
                        <a class="btn sv-btn-secundario sv-btn-sm" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
                        <button type="button" class="btn sv-btn-peligro sv-btn-sm"
                                data-eliminar
                                data-url="@Url.Action(nameof(MascotasController.ConfirmarEliminar), "Mascotas", new { id = Model.Id })"
                                data-mensaje="Se eliminará a @Model.Nombre junto con sus @(Model.Consultas.Count) consulta(s). Esta acción no se puede deshacer.">
                            Eliminar
                        </button>
                    </div>
                </div>
            </div>
        }

<section class="sv-ficha mb-4">
    <h2 class="sv-seccion-titulo">Datos generales</h2>
    <dl class="sv-ficha-datos">
        <div>
            <dt>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.366.366 0 0 0 .101.025.366.366 0 0 0 .101-.025c.075-.023.173-.061.293-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                    <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                </svg>
                Estado
            </dt>
            <dd><span class="sv-estado @(Model.EstaActivo ? "" : "inactivo")">@(Model.EstaActivo ? "Activo" : "Inactivo")</span></dd>
        </div>
        <div>
            <dt>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM2 2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H2z"/>
                    <path d="M2.5 4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H3a.5.5 0 0 1-.5-.5V4z"/>
                </svg>
                Edad
            </dt>
            <dd>@Model.EdadEnMeses meses</dd>
        </div>
        <div>
            <dt>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM6 7a1 1 0 0 1 1 1v5a1 1 0 0 1-2 0V8a1 1 0 0 1 1-1zm-4 4a1 1 0 0 1 1 1v2a1 1 0 0 1-2 0v-2a1 1 0 0 1 1-1z"/>
                </svg>
                Peso
            </dt>
            <dd>@Model.PesoEnKg.ToString("0.##") kg</dd>
        </div>
        <div>
            <dt>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664h10z"/>
                </svg>
                Dueño
            </dt>
            <dd>@Model.NombreDelDuenio</dd>
        </div>
        <div>
            <dt>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M11 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h6zM5 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H5z"/>
                    <path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                </svg>
                Teléfono del dueño
            </dt>
            <dd>@Model.TelefonoDelDuenio</dd>
        </div>
        <div>
            <dt>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                    <path d="M3 3.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zM3 6a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 6zm0 2.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                </svg>
                Notas
            </dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Notas) ? "Sin notas." : Model.Notas)</dd>
        </div>
    </dl>
</section>

<section class="sv-ficha">
    <h2 class="sv-seccion-titulo">Historial de consultas (@Model.Consultas.Count)</h2>

    @if (Model.Consultas.Count == 0)
    {
        <p class="sv-subtitulo mb-2">Esta mascota aún no tiene consultas registradas.</p>
        <a class="btn sv-btn-secundario" asp-controller="Consultas" asp-action="Crear" asp-route-mascotaId="@Model.Id">Registrar la primera</a>
    }
    else
    {
        <div class="sv-consulta-lista">
            @foreach (var consulta in Model.Consultas.OrderByDescending(c => c.Fecha))
            {
                <article class="sv-consulta-tarjeta">
                    <header class="sv-consulta-cabeza">
                        <span class="sv-consulta-fecha">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM2 2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H2z"/>
                                <path d="M2.5 4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H3a.5.5 0 0 1-.5-.5V4z"/>
                            </svg>
                            @consulta.Fecha.ToString("dd/MM/yyyy")
                        </span>
                        <div class="d-inline-flex gap-1">
                            <button type="button" class="sv-icono-btn sv-icono-editar"
                                    onclick="location.href='@Url.Action(nameof(ConsultasController.Editar), "Consultas", new { id = consulta.Id })'"
                                    title="Editar consulta" aria-label="Editar consulta del @consulta.Fecha.ToString("dd/MM/yyyy")">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                </svg>
                            </button>
                            <button type="button" class="sv-icono-btn sv-icono-peligro"
                                    data-eliminar
                                    data-url="@Url.Action(nameof(ConsultasController.ConfirmarEliminar), "Consultas", new { id = consulta.Id })"
                                    data-mensaje="Se eliminará la consulta del @consulta.Fecha.ToString("dd/MM/yyyy") (@consulta.Motivo). Esta acción no se puede deshacer."
                                    title="Eliminar consulta" aria-label="Eliminar consulta del @consulta.Fecha.ToString("dd/MM/yyyy")">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4z"/>
                                </svg>
                            </button>
                        </div>
                    </header>
                    <p class="sv-consulta-resumen">
                        <strong>Motivo:</strong> @consulta.Motivo
                        <span>|</span>
                        <strong>Síntomas:</strong> @(string.IsNullOrWhiteSpace(consulta.Sintomas) ? "Sin síntomas registrados" : consulta.Sintomas)
                        <span>|</span>
                        <strong>Diagnóstico:</strong> @(string.IsNullOrWhiteSpace(consulta.Diagnostico) ? "Sin diagnóstico registrado" : consulta.Diagnostico)
                    </p>
                    <dl class="sv-consulta-datos">
                        <div>
                            <dt>Motivo</dt>
                            <dd>@consulta.Motivo</dd>
                        </div>
                        <div>
                            <dt>Síntomas</dt>
                            <dd>@(string.IsNullOrWhiteSpace(consulta.Sintomas) ? "—" : consulta.Sintomas)</dd>
                        </div>
                        <div>
                            <dt>Diagnóstico</dt>
                            <dd>@(string.IsNullOrWhiteSpace(consulta.Diagnostico) ? "—" : consulta.Diagnostico)</dd>
                        </div>
                        <div>
                            <dt>Tratamiento</dt>
                            <dd>@(string.IsNullOrWhiteSpace(consulta.Tratamiento) ? "—" : consulta.Tratamiento)</dd>
                        </div>
                    </dl>
                </article>
            }
        </div>
    }
</section>
    </div>
    <div class="col-12 col-lg-5">
        <figure class="sv-doctor-panel" role="img" aria-label="Veterinario de SaludVital">
            <img src="~/images/doctor.jpg" alt="Veterinario de SaludVital" />
            <figcaption class="sv-doctor-leyenda">
                <span class="sv-doctor-frase sv-frase-escritura">Cuidar a tu mascota es cuidar una parte de tu familia.</span>
                <span class="sv-doctor-parrafo">En SaludVital nos ocupamos de la salud y la felicidad de tu compañero de vida.</span>
                <a class="btn sv-btn-primario sv-doctor-boton" asp-controller="Mascotas" asp-action="Crear">Registrar mascota</a>
            </figcaption>
        </figure>
    </div>
</div>

<div class="mt-4">
    <a class="btn sv-btn-secundario" asp-action="Index">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8.354 1.646a.5.5 0 0 0-.708 0l-6 6a.5.5 0 0 0 0 .708l6 6a.5.5 0 0 0 .708-.708L2.707 8l7.647-7.646a.5.5 0 0 0 0-.708z"/>
            <path d="M2.707 8H15.5a.5.5 0 0 0 0-1H2.707l7.647-7.646a.5.5 0 0 0-.708-.708l-6 6a.5.5 0 0 0 0 .708l6 6a.5.5 0 0 0 .708-.708z"/>
        </svg>
        Volver al catálogo
    </a>
</div>

<partial name="_ModalEliminar" />
