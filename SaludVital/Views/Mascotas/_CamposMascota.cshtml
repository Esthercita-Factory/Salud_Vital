@model Mascota

<div class="sv-form-seccion">
    <h2 class="sv-seccion-titulo">Datos de la mascota</h2>
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="form-group">
                <label asp-for="Nombre" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M6 4.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0m4.5 0a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0M13 4.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0M14.5 9c-.5 0-1.5.5-2.5.5s-2-.5-2.5-.5c-.6 0-1 .5-1 1 0 .8.6 2 2.5 2s3-1.2 3-2c0-.5-.5-1-1-1M6 9c-.5 0-1.5.5-2.5.5S1.5 9 1 9c-.6 0-1 .5-1 1 0 .8.6 2 2.5 2s3-1.2 3-2c0-.5-.5-1-1-1"/>
                        </svg>
                    </span>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej.: Rocky" />
                </div>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="form-group">
                <label asp-for="Especie" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M6 4.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0m4.5 0a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0M13 4.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0M14.5 9c-.5 0-1.5.5-2.5.5s-2-.5-2.5-.5c-.6 0-1 .5-1 1 0 .8.6 2 2.5 2s3-1.2 3-2c0-.5-.5-1-1-1M6 9c-.5 0-1.5.5-2.5.5S1.5 9 1 9c-.6 0-1 .5-1 1 0 .8.6 2 2.5 2s3-1.2 3-2c0-.5-.5-1-1-1"/>
                        </svg>
                    </span>
                    <input asp-for="Especie" class="form-control" list="especies" placeholder="Perro, Gato..." />
                </div>
                <datalist id="especies">
                    <option value="Perro"></option>
                    <option value="Gato"></option>
                    <option value="Conejo"></option>
                    <option value="Ave"></option>
                    <option value="Roedor"></option>
                    <option value="Otra"></option>
                </datalist>
                <span asp-validation-for="Especie" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="form-group">
                <label asp-for="Raza" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M2 1a1 1 0 0 0-1 1v4.586a1 1 0 0 0 .293.707l7 7a1 1 0 0 0 1.414 0l4.586-4.586a1 1 0 0 0 0-1.414l-7-7A1 1 0 0 0 6.586 1zm4 3.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                        </svg>
                    </span>
                    <input asp-for="Raza" class="form-control" placeholder="Ej.: Labrador, Siames, Mini Lop" />
                </div>
                <span asp-validation-for="Raza" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label">Sexo</label>
                <div class="btn-group w-100" role="group" aria-label="Sexo de la mascota">
                    @foreach (var sexo in Enum.GetValues<Sexo>())
                    {
                        <input type="radio" class="btn-check" asp-for="Sexo" id="sexo-@sexo" value="@sexo" />
                        <label class="btn sv-btn-sexo" for="sexo-@sexo">@(sexo == Sexo.Macho ? "Macho" : "Hembra")</label>
                    }
                </div>
                <span asp-validation-for="Sexo" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="form-group">
                <label asp-for="EdadEnMeses" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
                        </svg>
                    </span>
                    <input asp-for="EdadEnMeses" class="form-control" type="number" min="0" max="600" step="1" placeholder="Ej.: 24" />
                </div>
                <span asp-validation-for="EdadEnMeses" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="form-group">
                <label asp-for="PesoEnKg" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M12 1a1 1 0 0 1 1 1v1h3v1h-1.812c.107.339.216.672.31 1H17a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2.91l.76 2.539A1.5 1.5 0 0 1 13.5 14a1.5 1.5 0 0 1-1.65-1.46L11 9.9V8h.5a.5.5 0 0 1 .5.5.5.5 0 0 0 1 0A1.5 1.5 0 0 0 12 7.5V7h-8V6h8V3H4v3h.5A1.5 1.5 0 0 1 6 7.5.5.5 0 0 0 7 7.5.5.5 0 0 1 7.5 7H8v1.9l-.87 2.64A1.5 1.5 0 0 1 5.5 14a1.5 1.5 0 0 1-1.44-1.961L4.82 9.5H4a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1h.5L4.19 4H2V3h3V2a1 1 0 0 1 1-1zM6 4h6V3H6zM3.5 6.5v1.5h2V6.5zm11 0v1.5h2V6.5zM11.1 9.5H8.9l.43 1.4h1.34zM7.5 12a.5.5 0 0 0-.5.5V13a1 1 0 0 0 1 1h1a.5.5 0 0 0 0-1h-1z"/>
                        </svg>
                    </span>
                    <input asp-for="PesoEnKg" class="form-control" type="number" min="0.1" max="300" step="any" placeholder="Ej.: 8.5" />
                </div>
                <span asp-validation-for="PesoEnKg" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="sv-form-seccion">
    <h2 class="sv-seccion-titulo">Datos del dueño</h2>
    <div class="row g-3">
        <div class="col-12 col-md-8">
            <div class="form-group">
                <label asp-for="NombreDelDuenio" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664z"/>
                        </svg>
                    </span>
                    <input asp-for="NombreDelDuenio" class="form-control" placeholder="Ej.: María García" />
                </div>
                <span asp-validation-for="NombreDelDuenio" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="form-group">
                <label asp-for="TelefonoDelDuenio" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z"/>
                        </svg>
                    </span>
                    <input asp-for="TelefonoDelDuenio" class="form-control" placeholder="Ej.: 3001234567" />
                </div>
                <span asp-validation-for="TelefonoDelDuenio" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="sv-form-seccion">
    <h2 class="sv-seccion-titulo">Estado y notas</h2>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="form-group h-100 d-flex flex-column justify-content-center">
                <div class="sv-activo-fila d-flex align-items-center justify-content-between">
                    <label asp-for="EstaActivo" class="form-label mb-0"></label>
                    <div class="form-check form-switch sv-switch mb-0">
                        <input asp-for="EstaActivo" class="form-check-input" role="switch" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-8">
            <div class="form-group">
                <label asp-for="Notas" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/>
                        </svg>
                    </span>
                    <textarea asp-for="Notas" class="form-control" rows="3"></textarea>
                </div>
                <span asp-validation-for="Notas" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>
