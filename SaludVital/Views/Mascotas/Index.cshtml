@model List<Mascota>
@{
    ViewData["Title"] = "Mascotas";
    var busqueda = ViewBag.Busqueda as string;
    var totalMascotas = (int?)ViewBag.TotalMascotas ?? 0;
    var mascotasActivas = (int?)ViewBag.MascotasActivas ?? 0;
    var totalEspecies = (int?)ViewBag.TotalEspecies ?? 0;
    var especiesDisponibles = ViewBag.EspeciesDisponibles as List<string> ?? [];
}

<section class="sv-page-header" aria-labelledby="titulo-mascotas">
    <div class="sv-page-header-top">
        <div class="sv-page-heading">
            <div class="sv-page-eyebrow">Catálogo de pacientes</div>
            <h1 id="titulo-mascotas">Mascotas</h1>
            <p>Pacientes registrados en Patitas Felices.</p>
        </div>
        <a class="sv-page-primary-action" asp-action="Crear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Nueva mascota
        </a>
    </div>

    <div class="sv-page-stats" aria-label="Resumen del catálogo">
        <div class="sv-stat-chip">
            <div class="ico sv-stat-ico-blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" aria-hidden="true">
                    <path d="M12 2v20M17 5l-5-3-5 3M17 19l-5 3-5-3" />
                </svg>
            </div>
            <b>@totalMascotas</b><span>pacientes en total</span>
        </div>
        <div class="sv-stat-chip">
            <div class="ico sv-stat-ico-teal">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" aria-hidden="true">
                    <path d="m5 12 4 4L19 6" />
                </svg>
            </div>
            <b>@mascotasActivas</b><span>activas</span>
        </div>
        <div class="sv-stat-chip">
            <div class="ico sv-stat-ico-purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" aria-hidden="true">
                    <rect x="4" y="4" width="6" height="6" rx="1" /><rect x="14" y="4" width="6" height="6" rx="1" /><rect x="4" y="14" width="6" height="6" rx="1" /><rect x="14" y="14" width="6" height="6" rx="1" />
                </svg>
            </div>
            <b>@totalEspecies</b><span>especies distintas</span>
        </div>
    </div>

    <div class="sv-page-search-row">
        <form class="sv-page-search" role="search" onsubmit="return false;">
            <label for="busqueda" class="visually-hidden">Buscar por nombre, especie, raza o dueño</label>
            <svg class="sv-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
            </svg>
            <input type="search" id="busqueda" value="@busqueda" placeholder="Buscar por nombre, especie, raza o dueño..." autocomplete="off" />
        </form>
        <div class="sv-filter-list" role="group" aria-label="Filtrar por especie">
            <button type="button" class="sv-filter-chip active" data-especie="">Todas</button>
            @foreach (var especieDisponible in especiesDisponibles)
            {
                <button type="button" class="sv-filter-chip" data-especie="@especieDisponible">@especieDisponible</button>
            }
        </div>
    </div>
</section>

@if (Model.Count == 0)
{
    <div class="sv-vacio">
        <p class="mb-2">No se encontraron mascotas@(string.IsNullOrWhiteSpace(busqueda) ? "" : " con ese criterio de búsqueda").</p>
        <a class="btn sv-btn-primario" asp-action="Crear">Registrar la primera mascota</a>
    </div>
}
else
{
    <div id="sv-catalogo-grid" class="row g-3">
        @foreach (var mascota in Model)
        {
            <div class="col-6 col-sm-6 col-lg-4">
                <div class="sv-tarjeta-mascota">
@{
    var especie = (mascota.Especie ?? "").ToLowerInvariant();
    var claseCabeza = especie switch
    {
        "perro" => "sv-cabeza-img sv-cabeza-perro",
        "gato" => "sv-cabeza-img sv-cabeza-gato",
        "conejo" => "sv-cabeza-img sv-cabeza-conejo",
        "loro" => "sv-cabeza-img sv-cabeza-loro",
        _ => ""
                    };
}
                    <div class="sv-tarjeta-cabeza @claseCabeza">
                        <div class="sv-tarjeta-identidad">
                            <div class="d-flex align-items-center gap-2 min-w-0">
                                <span class="sv-avatar" aria-hidden="true">
                                    <partial name="_IconoEspecie" model="mascota.Especie" />
                                </span>
                                <div class="min-w-0">
                                    <h3 class="sv-tarjeta-nombre mb-0 text-truncate" title="@mascota.Nombre">@mascota.Nombre</h3>
                                    <span class="sv-tarjeta-sub text-truncate d-block" title="@mascota.Especie">@mascota.Especie</span>
                                </div>
                            </div>
                            <div class="sv-tarjeta-dueno">
                                <span class="sv-dueno-icono" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664z"/>
                                    </svg>
                                </span>
                                <div class="min-w-0">
                                    <span class="sv-tarjeta-etiqueta">Dueño</span>
                                    <span class="sv-tarjeta-dueno-nombre text-truncate d-block" title="@mascota.NombreDelDuenio">@mascota.NombreDelDuenio</span>
                                </div>
                            </div>
                        </div>
                        <span class="sv-estado @(mascota.EstaActivo ? "" : "inactivo")">@(mascota.EstaActivo ? "Activo" : "Inactivo")</span>
                    </div>
                    <div class="sv-tarjeta-pie">
                        <a class="sv-enlace-tarjeta" href="@Url.Action(nameof(MascotasController.Detalles), "Mascotas", new { id = mascota.Id })">Ver ficha
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                            </svg>
                        </a>
                        <div class="d-inline-flex gap-1 ms-auto">
                            <button type="button" class="sv-icono-btn sv-icono-editar"
                                    onclick="location.href='@Url.Action(nameof(MascotasController.Editar), "Mascotas", new { id = mascota.Id })'"
                                    title="Editar" aria-label="Editar a @mascota.Nombre">
                                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                </svg>
                            </button>
                            <button type="button" class="sv-icono-btn sv-icono-peligro"
                                    data-eliminar
                                    data-url="@Url.Action(nameof(MascotasController.ConfirmarEliminar), "Mascotas", new { id = mascota.Id })"
                                    data-mensaje="Se eliminará a @mascota.Nombre junto con sus @(mascota.Consultas.Count) consulta(s). Esta acción no se puede deshacer."
                                    title="Eliminar" aria-label="Eliminar a @mascota.Nombre">
                                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div id="sv-catalogo-sin-resultados" class="sv-vacio sv-catalogo-sin-resultados" hidden>
        <p class="mb-2">No se encontraron mascotas con esos filtros.</p>
        <a class="btn sv-btn-primario" asp-action="Crear">Registrar mascota</a>
    </div>
}

<partial name="_ModalEliminar" />
