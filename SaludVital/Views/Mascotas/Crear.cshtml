@model Mascota
@{
    ViewData["Title"] = "Registrar mascota";
}

<div class="sv-cabecera-ficha">
    <div>
        <h1 class="sv-titulo-pagina mb-1">Registrar mascota</h1>
        <p class="sv-subtitulo mb-0">Complete los datos del nuevo paciente.</p>
    </div>
    <a class="btn sv-btn-secundario" asp-action="Index">Volver al catálogo</a>
</div>

<div class="row g-4 align-items-start">
    <div class="col-12 col-lg-5 order-first order-lg-last">
        <div class="sv-panel-huellas" aria-hidden="true">
            <p class="sv-panel-titulo">Registra tu mascota aquí</p>
            <p class="sv-panel-subtitulo">Completa el formulario para darle la bienvenida al nuevo paciente.</p>
            <div class="sv-huellas">
                <span class="sv-pata sv-pata-1">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor">
                        <ellipse cx="21" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="33" cy="18" rx="5.5" ry="6"/>
                        <ellipse cx="45" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="54" cy="33" rx="4.8" ry="5.8"/>
                        <ellipse cx="33" cy="41" rx="12" ry="9.5" transform="rotate(-8 33 41)"/>
                    </svg>
                </span>
                <span class="sv-pata sv-pata-2">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor">
                        <ellipse cx="21" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="33" cy="18" rx="5.5" ry="6"/>
                        <ellipse cx="45" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="54" cy="33" rx="4.8" ry="5.8"/>
                        <ellipse cx="33" cy="41" rx="12" ry="9.5" transform="rotate(-8 33 41)"/>
                    </svg>
                </span>
                <span class="sv-pata sv-pata-3">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor">
                        <ellipse cx="21" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="33" cy="18" rx="5.5" ry="6"/>
                        <ellipse cx="45" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="54" cy="33" rx="4.8" ry="5.8"/>
                        <ellipse cx="33" cy="41" rx="12" ry="9.5" transform="rotate(-8 33 41)"/>
                    </svg>
                </span>
                <span class="sv-pata sv-pata-4">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor">
                        <ellipse cx="21" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="33" cy="18" rx="5.5" ry="6"/>
                        <ellipse cx="45" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="54" cy="33" rx="4.8" ry="5.8"/>
                        <ellipse cx="33" cy="41" rx="12" ry="9.5" transform="rotate(-8 33 41)"/>
                    </svg>
                </span>
                <span class="sv-pata sv-pata-5">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor">
                        <ellipse cx="21" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="33" cy="18" rx="5.5" ry="6"/>
                        <ellipse cx="45" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="54" cy="33" rx="4.8" ry="5.8"/>
                        <ellipse cx="33" cy="41" rx="12" ry="9.5" transform="rotate(-8 33 41)"/>
                    </svg>
                </span>
                <span class="sv-pata sv-pata-6">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor">
                        <ellipse cx="21" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="33" cy="18" rx="5.5" ry="6"/>
                        <ellipse cx="45" cy="24" rx="5.5" ry="6"/>
                        <ellipse cx="54" cy="33" rx="4.8" ry="5.8"/>
                        <ellipse cx="33" cy="41" rx="12" ry="9.5" transform="rotate(-8 33 41)"/>
                    </svg>
                </span>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="sv-ficha">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <partial name="_CamposMascota" model="Model" />

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn sv-btn-primario">Registrar mascota</button>
                    <a class="btn sv-btn-secundario" asp-action="Index">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
