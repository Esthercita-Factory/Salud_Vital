@model Mascota

<div class="sv-form-seccion">
    <h2 class="sv-seccion-titulo">Datos de la mascota</h2>
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="sv-field">
                <label asp-for="Nombre" class="form-label"></label>
                <div class="sv-input-wrap">
                    <svg class="sv-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 2v20M17 5l-5-3-5 3M17 19l-5 3-5-3" />
                    </svg>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej.: Rocky" />
                </div>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="sv-field">
                <label asp-for="Especie" class="form-label"></label>
                <div class="sv-input-wrap">
                    <svg class="sv-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M4 12h16M4 6h16M4 18h16" />
                    </svg>
                    <input asp-for="Especie" class="form-control" list="especies" placeholder="Perro, Gato..." />
                </div>
                <datalist id="especies">
                    <option value="Perro"></option>
                    <option value="Gato"></option>
                    <option value="Conejo"></option>
                    <option value="Ave"></option>
                    <option value="Roedor"></option>
                    <option value="Otra"></option>
                </datalist>
                <span asp-validation-for="Especie" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="sv-field">
                <label asp-for="Raza" class="form-label"></label>
                <div class="sv-input-wrap">
                    <svg class="sv-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 7h.01M7 3h5l9 9-8 8-9-9V3z" />
                    </svg>
                    <input asp-for="Raza" class="form-control" placeholder="Ej.: Labrador, Siames, Mini Lop" />
                </div>
                <span asp-validation-for="Raza" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="sv-field">
                <label class="form-label">Sexo</label>
                <div class="sv-sex-options" role="group" aria-label="Sexo de la mascota">
                    @foreach (var sexo in Enum.GetValues<Sexo>())
                    {
                        <input type="radio" class="btn-check" asp-for="Sexo" id="sexo-@sexo" value="@sexo" />
                        <label class="sv-btn-sexo" for="sexo-@sexo">@(sexo == Sexo.Macho ? "Macho" : "Hembra")</label>
                    }
                </div>
                <span asp-validation-for="Sexo" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="sv-field">
                <label asp-for="EdadEnMeses" class="form-label"></label>
                <div class="sv-input-wrap">
                    <svg class="sv-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    <input asp-for="EdadEnMeses" class="form-control" type="number" min="0" max="600" step="1" placeholder="Ej.: 24" />
                </div>
                <span asp-validation-for="EdadEnMeses" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="sv-field">
                <label asp-for="PesoEnKg" class="form-label"></label>
                <div class="sv-input-wrap">
                    <svg class="sv-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 3l4 4-4 4-4-4 4-4zM4 21l3-10h10l3 10H4z" />
                    </svg>
                    <input asp-for="PesoEnKg" class="form-control" type="number" min="0.1" max="300" step="any" placeholder="Ej.: 8.5" />
                </div>
                <span asp-validation-for="PesoEnKg" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="sv-form-seccion">
    <h2 class="sv-seccion-titulo">Datos del dueño</h2>
    <div class="row g-3">
        <div class="col-12 col-md-8">
            <div class="sv-field">
                <label asp-for="NombreDelDuenio" class="form-label"></label>
                <div class="sv-input-wrap">
                    <svg class="sv-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
                    </svg>
                    <input asp-for="NombreDelDuenio" class="form-control" placeholder="Ej.: María García" />
                </div>
                <span asp-validation-for="NombreDelDuenio" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="sv-field">
                <label asp-for="TelefonoDelDuenio" class="form-label"></label>
                <div class="sv-input-wrap">
                    <svg class="sv-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .7 3a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.5c1 .4 2 .6 3 .7a2 2 0 0 1 1.7 2z" />
                    </svg>
                    <input asp-for="TelefonoDelDuenio" class="form-control" placeholder="Ej.: 3001234567" />
                </div>
                <span asp-validation-for="TelefonoDelDuenio" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="sv-form-seccion">
    <h2 class="sv-seccion-titulo">Estado de salud y notas</h2>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="sv-health-status">
                <label asp-for="EstaActivo" class="form-label"></label>
                <div class="sv-activo-fila">
                    <span class="sv-status-dot" aria-hidden="true"></span>
                    <span>Paciente activo</span>
                    <div class="form-check form-switch sv-switch mb-0">
                        <input asp-for="EstaActivo" class="form-check-input" role="switch" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-8">
            <div class="sv-field">
                <label asp-for="Notas" class="form-label"></label>
                <div class="sv-input-wrap sv-textarea-wrap">
                    <svg class="sv-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    <textarea asp-for="Notas" class="form-control" rows="3" placeholder="Observaciones importantes..."></textarea>
                </div>
                <span asp-validation-for="Notas" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>
